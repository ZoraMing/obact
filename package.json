{
  "name": "obact-monorepo",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "workspaces": [
    "packages/*",
    "lab"
  ],
  "scripts": {
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test \"packages/*/test/**/*.test.ts\" \"lab/test/**/*.test.ts\" \"fixtures/test/**/*.test.ts\"",
    "gen:types": "npm run gen:types -w @obact/schemas",
    "check": "npm run lint && npm run typecheck && npm run check:types -w @obact/schemas && npm test",
    "browser:install": "node tools/browser.ts install"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "22.20.5",
    "typescript": "6.0.3",
    "@puppeteer/browsers": "3.2.3"
  }
}
