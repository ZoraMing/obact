# Obact 配置模板。复制为 .env 后填写；Obact 启动时自动加载，已经存在的环境变量优先。

# 必填：模型接口（OpenAI 格式，模型必须支持图像输入，本地或云端都可以）
MODEL_BASE_URL = https://example.com/v1
MODEL_NAME = 视觉模型名
MODEL_KEY = 你的密钥

# 可选：更聪明的 smart 模型，上面的模型失败时升级使用；没写的项沿用上面的设置
# SMART_MODEL_BASE_URL = https://example.com/v1
# SMART_MODEL_NAME = 更强的视觉模型名
# SMART_MODEL_KEY = 你的密钥

# 可选：无头运行（默认显示浏览器窗口）
# OBACT_HEADLESS = true
# 可选：浏览器用户目录，跨运行保留登录状态；不填每次用临时目录
# OBACT_USER_DATA_DIR = workspace/profiles/default
