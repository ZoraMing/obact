# Obact 配置模板。复制为 .env 后修改；Obact 启动时自动加载，已经存在的环境变量优先。

# 模型（必填）：两个槽位都必须支持图像输入，接口为 OpenAI 格式，本地或云端都可以
OPENAI_URL = https://example.com/v1
OPENAI_MODEL = 视觉模型名
OPENAI_KEY = 你的密钥

# 可选：单独设置某个槽位。fast 没写的项用上面的 OPENAI_*，smart 没写的项沿用 fast
# OBACT_FAST_URL =
# OBACT_FAST_MODEL =
# OBACT_FAST_KEY =
# OBACT_SMART_URL =
# OBACT_SMART_MODEL =
# OBACT_SMART_KEY =
# OBACT_FAST_COORDS = pixel            # 模型按 0-1000 归一化输出坐标时（如 Qwen3-VL）设为 norm1000
# OBACT_SMART_COORDS = pixel

# 可选：浏览器与缓存
# OBACT_VIEWPORT = 1280x800            # 固定视口，保证 canvas 坐标可以复用
# OBACT_HEADLESS = false               # wait_for_human 需要有头浏览器
# OBACT_CACHE_DIR = .obact
# OBACT_USER_DATA_DIR = workspace/profiles/default   # 浏览器用户目录，跨运行保留登录状态；不填每次用临时目录
# OBACT_EXECUTABLE_PATH = C:/Program Files/Google/Chrome/Application/chrome.exe

# 可选：tasks/community.py 登录 Conduit 用的账号；不填则自动注册测试账号并保存复用
# CONDUIT_EMAIL =
# CONDUIT_PASSWORD =
