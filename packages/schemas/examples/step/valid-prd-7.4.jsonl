{"step_id": "s08", "op": "end_if"}
{"step_id": "s10", "op": "extract", "pageId": "main", "source": {"type": "response", "url": "/api/quotes\\?page=\\d+", "path": "quotes"}, "key": "text", "wait_ms": 5000}
{"step_id": "s11", "op": "new_page", "url": "https://example.com/report"}
{"step_id": "s12", "op": "checkpoint"}
