{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://obact.local/schemas/v1/action.json",
  "title": "Action",
  "description": "act 方法的参数：一个动作（FR-12、FR-32，PRD 7.7）。命名对齐 chrome-devtools-mcp。除 new_page 外都必须带 pageId。",
  "type": "object",
  "allOf": [{ "$ref": "#/$defs/Common" }, { "$ref": "#/$defs/Op" }],
  "if": { "properties": { "op": { "const": "new_page" } } },
  "else": { "required": ["pageId"] },
  "unevaluatedProperties": false,
  "$defs": {
    "Common": {
      "type": "object",
      "properties": {
        "op": { "type": "string" },
        "pageId": { "$ref": "common.json#/$defs/PageId" },
        "timeout_ms": { "type": "integer", "minimum": 0 },
        "post": {
          "type": "array",
          "items": { "$ref": "common.json#/$defs/Assertion" },
          "description": "后置检查；通过即继续（FR-14）。"
        },
        "diff": { "type": "boolean", "description": "是否返回页面变化差异，默认 false（FR-15）。" },
        "screenshot": { "type": "boolean", "description": "动作后截图。" }
      },
      "required": ["op"]
    },
    "Op": {
      "oneOf": [
        { "$ref": "#/$defs/Click" },
        { "$ref": "#/$defs/Hover" },
        { "$ref": "#/$defs/Fill" },
        { "$ref": "#/$defs/FillForm" },
        { "$ref": "#/$defs/TypeText" },
        { "$ref": "#/$defs/PressKey" },
        { "$ref": "#/$defs/Drag" },
        { "$ref": "#/$defs/UploadFile" },
        { "$ref": "#/$defs/HandleDialog" },
        { "$ref": "#/$defs/Scroll" },
        { "$ref": "#/$defs/ClickAt" },
        { "$ref": "#/$defs/MouseMove" },
        { "$ref": "#/$defs/NavigatePage" },
        { "$ref": "#/$defs/NewPage" },
        { "$ref": "#/$defs/SelectPage" },
        { "$ref": "#/$defs/ClosePage" },
        { "$ref": "#/$defs/TakeScreenshot" },
        { "$ref": "#/$defs/WaitFor" },
        { "$ref": "#/$defs/Assert" },
        { "$ref": "#/$defs/Extract" },
        { "$ref": "#/$defs/EvaluateScript" }
      ]
    },
    "MouseButton": { "type": "string", "enum": ["left", "right", "middle"] },
    "Modifiers": {
      "type": "array",
      "items": { "type": "string", "enum": ["Alt", "Control", "Meta", "Shift"] },
      "uniqueItems": true
    },
    "Click": {
      "type": "object",
      "properties": {
        "op": { "const": "click" },
        "target": { "$ref": "common.json#/$defs/Target" },
        "button": { "$ref": "#/$defs/MouseButton" },
        "double": { "type": "boolean" },
        "modifiers": { "$ref": "#/$defs/Modifiers" }
      },
      "required": ["op", "target"]
    },
    "Hover": {
      "type": "object",
      "properties": {
        "op": { "const": "hover" },
        "target": { "$ref": "common.json#/$defs/Target" }
      },
      "required": ["op", "target"]
    },
    "FillValue": {
      "description": "文本框填文本；下拉框填选项文本或值，多选下拉框用逗号（半角或全角）分隔多项，选中恰好这些项，空串取消全部；复选框填布尔。可含模板 {{param:..}} / {{var:..}}。",
      "type": ["string", "number", "boolean"]
    },
    "Fill": {
      "type": "object",
      "properties": {
        "op": { "const": "fill" },
        "target": { "$ref": "common.json#/$defs/Target" },
        "value": { "$ref": "#/$defs/FillValue" }
      },
      "required": ["op", "target", "value"]
    },
    "FillForm": {
      "type": "object",
      "properties": {
        "op": { "const": "fill_form" },
        "elements": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "target": { "$ref": "common.json#/$defs/Target" },
              "value": { "$ref": "#/$defs/FillValue" }
            },
            "required": ["target", "value"],
            "additionalProperties": false
          }
        }
      },
      "required": ["op", "elements"]
    },
    "TypeText": {
      "description": "在当前焦点（或先聚焦 target）逐字键入。",
      "type": "object",
      "properties": {
        "op": { "const": "type_text" },
        "text": { "type": "string" },
        "target": { "$ref": "common.json#/$defs/Target" }
      },
      "required": ["op", "text"]
    },
    "PressKey": {
      "type": "object",
      "properties": {
        "op": { "const": "press_key" },
        "key": { "type": "string", "minLength": 1, "description": "如 Enter、Control+A。" }
      },
      "required": ["op", "key"]
    },
    "DragEnd": {
      "anyOf": [{ "$ref": "common.json#/$defs/Target" }, { "$ref": "common.json#/$defs/Point" }]
    },
    "Drag": {
      "description": "按元素或按坐标拖拽（FR-32）。",
      "type": "object",
      "properties": {
        "op": { "const": "drag" },
        "from": { "$ref": "#/$defs/DragEnd" },
        "to": { "$ref": "#/$defs/DragEnd" }
      },
      "required": ["op", "from", "to"]
    },
    "UploadFile": {
      "type": "object",
      "properties": {
        "op": { "const": "upload_file" },
        "target": { "$ref": "common.json#/$defs/Target" },
        "files": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 },
          "description": "工作区内的相对路径。"
        }
      },
      "required": ["op", "target", "files"]
    },
    "HandleDialog": {
      "type": "object",
      "properties": {
        "op": { "const": "handle_dialog" },
        "action": { "type": "string", "enum": ["accept", "dismiss"] },
        "prompt_text": { "type": "string" }
      },
      "required": ["op", "action"]
    },
    "Scroll": {
      "description": "滚动：给 target 则在该元素上滚动；给 at 则在该坐标处滚动；都不给则滚动页面。",
      "type": "object",
      "properties": {
        "op": { "const": "scroll" },
        "target": { "$ref": "common.json#/$defs/Target" },
        "at": { "$ref": "common.json#/$defs/Point" },
        "dx": { "type": "number" },
        "dy": { "type": "number" }
      },
      "required": ["op"],
      "not": { "required": ["target", "at"] }
    },
    "ClickAt": {
      "type": "object",
      "properties": {
        "op": { "const": "click_at" },
        "x": { "type": "number" },
        "y": { "type": "number" },
        "button": { "$ref": "#/$defs/MouseButton" },
        "double": { "type": "boolean" },
        "modifiers": { "$ref": "#/$defs/Modifiers" }
      },
      "required": ["op", "x", "y"]
    },
    "MouseMove": {
      "type": "object",
      "properties": {
        "op": { "const": "mouse_move" },
        "x": { "type": "number" },
        "y": { "type": "number" }
      },
      "required": ["op", "x", "y"]
    },
    "NavigatePage": {
      "type": "object",
      "properties": {
        "op": { "const": "navigate_page" },
        "type": { "type": "string", "enum": ["url", "back", "forward", "reload"] },
        "url": { "type": "string", "minLength": 1 }
      },
      "required": ["op"],
      "if": {
        "anyOf": [
          { "not": { "required": ["type"] } },
          { "properties": { "type": { "const": "url" } } }
        ]
      },
      "then": { "required": ["url"] }
    },
    "NewPage": {
      "description": "新建标签页；pageId 为期望使用的 ID，省略时由工具分配并在 effects.new_pages 返回。",
      "type": "object",
      "properties": { "op": { "const": "new_page" }, "url": { "type": "string" } },
      "required": ["op"]
    },
    "SelectPage": {
      "type": "object",
      "properties": { "op": { "const": "select_page" } },
      "required": ["op"]
    },
    "ClosePage": {
      "type": "object",
      "properties": { "op": { "const": "close_page" } },
      "required": ["op"]
    },
    "TakeScreenshot": {
      "type": "object",
      "properties": {
        "op": { "const": "take_screenshot" },
        "target": { "$ref": "common.json#/$defs/Target" },
        "full_page": { "type": "boolean" },
        "path": { "type": "string", "description": "工作区内保存路径；省略时自动命名。" }
      },
      "required": ["op"]
    },
    "WaitFor": {
      "type": "object",
      "properties": {
        "op": { "const": "wait_for" },
        "until": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "common.json#/$defs/Assertion" },
          "description": "全部满足即结束。"
        }
      },
      "required": ["op", "until"]
    },
    "Assert": {
      "type": "object",
      "properties": {
        "op": { "const": "assert" },
        "checks": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "common.json#/$defs/Assertion" }
        }
      },
      "required": ["op", "checks"]
    },
    "DomSource": {
      "description": "页面抽取（FR-09）。",
      "type": "object",
      "properties": {
        "type": { "const": "dom" },
        "kind": { "type": "string", "enum": ["table", "list", "kv"] },
        "root": { "$ref": "common.json#/$defs/Locator" },
        "item": { "type": "string", "description": "列表项的 CSS 选择器（相对 root）。" },
        "fields": {
          "type": "object",
          "additionalProperties": { "type": "string" },
          "description": "字段名 → 相对选择器；可用 \"sel@attr\" 取属性。"
        },
        "pagination": {
          "type": "object",
          "properties": {
            "next": { "$ref": "common.json#/$defs/Locator" },
            "max_pages": { "type": "integer", "minimum": 1 }
          },
          "required": ["next"],
          "additionalProperties": false
        },
        "scroll": {
          "type": "object",
          "properties": {
            "container": { "$ref": "common.json#/$defs/Locator" },
            "max_rounds": { "type": "integer", "minimum": 1 },
            "idle_rounds": {
              "type": "integer",
              "minimum": 1,
              "description": "连续多少轮没有新数据就结束。"
            }
          },
          "additionalProperties": false
        }
      },
      "required": ["type", "kind", "root"],
      "additionalProperties": false
    },
    "ResponseSource": {
      "description": "接口截获（FR-10，PRD 5.6）：读取上一个动作开始之后到达、URL 匹配的最近一条 JSON 响应。",
      "type": "object",
      "properties": {
        "type": { "const": "response" },
        "url": { "type": "string", "minLength": 1, "description": "URL 正则。" },
        "method": { "type": "string" },
        "path": { "type": "string", "description": "字段路径，如 data.list。" }
      },
      "required": ["type", "url", "path"],
      "additionalProperties": false
    },
    "Extract": {
      "type": "object",
      "properties": {
        "op": { "const": "extract" },
        "source": {
          "oneOf": [{ "$ref": "#/$defs/DomSource" }, { "$ref": "#/$defs/ResponseSource" }]
        },
        "key": { "type": "string", "description": "主键字段，用于去重。" },
        "wait_ms": { "type": "integer", "minimum": 0 },
        "into": { "type": "string", "description": "写入的采集输出名。" },
        "as": { "type": "string", "description": "同时存入的运行变量名。" }
      },
      "required": ["op", "source"]
    },
    "EvaluateScript": {
      "type": "object",
      "properties": {
        "op": { "const": "evaluate_script" },
        "function": {
          "type": "string",
          "minLength": 1,
          "description": "JS 函数源码，如 \"() => document.title\"。"
        },
        "args": { "type": "array" },
        "as": { "type": "string", "description": "结果存入的运行变量名（工作流中）。" }
      },
      "required": ["op", "function"]
    }
  }
}
