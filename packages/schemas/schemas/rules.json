{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://obact.local/schemas/v1/rules.json",
  "title": "PopupRules",
  "description": "弹窗规则文件（FR-23）：只在定位失败或被遮挡时检查，命中则执行处理动作后重试当前步骤。可放在工作流目录或工作区全局。",
  "type": "array",
  "items": { "$ref": "#/$defs/Rule" },
  "$defs": {
    "Rule": {
      "title": "PopupRule",
      "type": "object",
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9_.-]{1,64}$" },
        "match": { "$ref": "common.json#/$defs/Locator" },
        "url": { "type": "string", "description": "限定生效的 URL 正则。" },
        "actions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/RuleAction" },
          "description": "处理动作，作用于当前标签页。"
        },
        "created_from": { "type": "string", "description": "来源运行编号与步骤（写回时记录）。" }
      },
      "required": ["id", "match", "actions"],
      "additionalProperties": false,
      "description": "match 为弹窗本体的定位器。"
    },
    "RuleAction": {
      "type": "object",
      "allOf": [
        { "$ref": "action.json#/$defs/Common" },
        { "$ref": "action.json#/$defs/Op" },
        { "properties": { "target": { "$ref": "common.json#/$defs/Locator" } } }
      ],
      "not": { "required": ["pageId"] },
      "unevaluatedProperties": false
    }
  }
}
