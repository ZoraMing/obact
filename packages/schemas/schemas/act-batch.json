{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://obact.local/schemas/v1/act-batch.json",
  "title": "ActBatch",
  "description": "act_batch：依次执行多步动作，遇到失败即停，返回每步结果和最后的观察（FR-33）。",
  "$defs": {
    "Params": {
      "title": "ActBatchParams",
      "type": "object",
      "properties": {
        "actions": { "type": "array", "minItems": 1, "items": { "$ref": "action.json" } },
        "observe": { "$ref": "observe.json#/$defs/Params" }
      },
      "required": ["actions"],
      "additionalProperties": false,
      "description": "observe：结束后要返回的观察，省略则不观察。"
    },
    "Result": {
      "title": "ActBatchResult",
      "type": "object",
      "properties": {
        "results": { "type": "array", "items": { "$ref": "act-result.json" } },
        "stopped_at": {
          "type": ["integer", "null"],
          "minimum": 0,
          "description": "失败停止的动作下标；全部成功为 null。"
        },
        "observation": { "$ref": "observe.json#/$defs/Result" }
      },
      "required": ["results", "stopped_at"],
      "additionalProperties": false
    }
  }
}
