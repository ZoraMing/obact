{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://obact.local/schemas/v1/observe.json",
  "title": "Observe",
  "description": "observe 方法的参数与返回（FR-05、FR-31，PRD 7.2）。返回把页面分成两部分：可操作功能（elements / snapshot_text，每个元素带可用操作）与纯网页信息（text_md）。",
  "$defs": {
    "View": { "type": "string", "enum": ["text", "screenshot", "som", "axtree"] },
    "Params": {
      "title": "ObserveParams",
      "type": "object",
      "properties": {
        "pageId": { "$ref": "common.json#/$defs/PageId" },
        "views": {
          "type": "array",
          "items": { "$ref": "#/$defs/View" },
          "uniqueItems": true,
          "description": "默认 [\"text\"]。"
        },
        "max_chars": {
          "type": "integer",
          "minimum": 1000,
          "description": "文本快照与摘要的字符预算，默认 40000。"
        }
      },
      "required": ["pageId"],
      "additionalProperties": false
    },
    "ElementStates": {
      "type": "object",
      "properties": {
        "disabled": { "type": "boolean" },
        "checked": { "type": ["boolean", "string"], "description": "true / false / \"mixed\"" },
        "selected": { "type": "boolean" },
        "expanded": { "type": "boolean" },
        "focused": { "type": "boolean" },
        "required": { "type": "boolean" },
        "readonly": { "type": "boolean" },
        "editable": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "Element": {
      "title": "ObservedElement",
      "type": "object",
      "properties": {
        "ref": { "$ref": "common.json#/$defs/Ref" },
        "role": { "type": "string" },
        "name": { "type": "string" },
        "hint": {
          "type": "string",
          "description": "没有可访问名称时，从图标文件名、svg 引用、类名推断的提示（如 delete、star），只作参考，不用于定位。"
        },
        "actions": {
          "type": "array",
          "items": { "$ref": "#/$defs/ActionName" },
          "uniqueItems": true,
          "description": "可对该元素执行的动作（与 action.json 的 op 同名）；禁用时仍列出，由 states.disabled 表示当前不可用。"
        },
        "value": { "type": "string" },
        "input_type": {
          "type": "string",
          "description": "input 的 type（text、date、number、password 等），便于按格式填写。"
        },
        "href": { "type": "string", "description": "链接的目标地址（绝对 URL）。" },
        "options": {
          "type": "array",
          "maxItems": 100,
          "items": { "$ref": "#/$defs/Option" },
          "description": "下拉框、列表框、带 datalist 的输入框的可选项（最多 100 个）。"
        },
        "options_omitted": {
          "type": "integer",
          "minimum": 1,
          "description": "超出 100 个而未列出的选项数。"
        },
        "states": { "$ref": "#/$defs/ElementStates" },
        "bbox": { "$ref": "common.json#/$defs/BBox" },
        "visible_ratio": { "type": "number", "minimum": 0, "maximum": 1 },
        "clickable": { "type": "boolean" },
        "within": { "type": "string", "description": "所在行或容器（业务主键）的 CSS 选择器。" },
        "frame": {
          "type": "array",
          "items": { "type": "string" },
          "description": "所在 frame 的 iframe 选择器链；顶层文档省略。"
        }
      },
      "required": ["ref", "role", "name", "actions", "bbox", "visible_ratio", "clickable"],
      "additionalProperties": false,
      "description": "可操作功能：一个可交互元素及其可用操作。"
    },
    "Result": {
      "title": "ObserveResult",
      "type": "object",
      "properties": {
        "pageId": { "$ref": "common.json#/$defs/PageId" },
        "url": { "type": "string" },
        "title": { "type": "string" },
        "signature": {
          "type": ["string", "null"],
          "description": "命中的页面签名 ID，未命中为 null（FR-08）。"
        },
        "canvas_warning": { "type": "boolean" },
        "snapshot_text": {
          "type": "string",
          "description": "可操作功能：编号元素表，每行一个元素及其可用操作（view=text）。"
        },
        "elements": {
          "type": "array",
          "items": { "$ref": "#/$defs/Element" },
          "description": "可操作功能：与 snapshot_text 是同一批元素。"
        },
        "text_md": {
          "type": "string",
          "description": "纯网页信息：不可操作的内容（标题、正文、表格、列表、图片说明），Markdown 格式；不重复可操作元素的文字，表格等内容里的可操作元素用 [编号] 引用。"
        },
        "truncated": { "type": "boolean" },
        "viewport": { "$ref": "common.json#/$defs/Viewport" },
        "screenshot_path": { "type": "string" },
        "som_path": { "type": "string", "description": "编号框截图路径（view=som）。" },
        "axtree": {
          "type": "string",
          "description": "可访问性树文本（view=axtree），编号与 elements 一致。"
        }
      },
      "required": [
        "pageId",
        "url",
        "title",
        "signature",
        "canvas_warning",
        "elements",
        "text_md",
        "truncated",
        "viewport"
      ],
      "additionalProperties": false
    },
    "ActionName": {
      "type": "string",
      "enum": ["click", "hover", "fill", "type_text", "press_key", "drag", "upload_file", "scroll"]
    },
    "Option": {
      "type": "object",
      "properties": {
        "label": { "type": "string" },
        "value": { "type": "string" },
        "selected": { "type": "boolean" },
        "disabled": { "type": "boolean" }
      },
      "required": ["label"],
      "additionalProperties": false
    }
  }
}
